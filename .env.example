# =============================================================================
# Scout environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and MUST NEVER
# be committed. Secrets are supplied through the environment, never through
# prompts, repository configuration, or agent-visible context.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
SCOUT_ENV=development
SCOUT_LOG_LEVEL=INFO
SCOUT_LOG_JSON=false

# --- Datastores ------------------------------------------------------------
SCOUT_DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5433/scout
SCOUT_REDIS_URL=redis://localhost:6380/0

# --- Public URLs -----------------------------------------------------------
SCOUT_PUBLIC_URL=http://localhost:8000
SCOUT_DASHBOARD_URL=http://localhost:5173

# --- Artifacts / workspaces (host paths) ------------------------------------
SCOUT_ARTIFACT_ROOT=./var/artifacts
SCOUT_WORKSPACE_ROOT=./var/workspaces

# --- GitHub App (provide a real installation to enable live integration) ----
# Leave blank to run with the in-memory fake GitHub client.
SCOUT_GITHUB_APP_ID=
SCOUT_GITHUB_APP_SLUG=
SCOUT_GITHUB_PRIVATE_KEY_PATH=
SCOUT_GITHUB_WEBHOOK_SECRET=
SCOUT_GITHUB_API_URL=https://api.github.com

# --- LLM gateway -----------------------------------------------------------
# Provider is selected per-agent-role; `fake` runs fully offline and is the
# default so that the platform is testable without any external account.
SCOUT_LLM_DEFAULT_PROVIDER=fake
SCOUT_LLM_DEFAULT_MODEL=fake-deterministic
SCOUT_OPENAI_API_KEY=
SCOUT_ANTHROPIC_API_KEY=
SCOUT_LLM_MAX_CONCURRENT_CALLS=4
SCOUT_LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Sandbox ---------------------------------------------------------------
# local  = run commands directly on the host with resource limits (dev only)
# docker = run each command in a locked-down container (default for real use)
SCOUT_SANDBOX_BACKEND=local
SCOUT_SANDBOX_IMAGE=scout-sandbox-python:3.12
SCOUT_SANDBOX_MEMORY_MB=2048
SCOUT_SANDBOX_CPUS=1.0
SCOUT_SANDBOX_PIDS_LIMIT=256
SCOUT_SANDBOX_NETWORK=none
SCOUT_SANDBOX_COMMAND_TIMEOUT_SECONDS=900

# --- Concurrency limits (size these to the host: see ADR 0001) --------------
SCOUT_MAX_CONCURRENT_JOBS=2
SCOUT_MAX_CONCURRENT_SANDBOXES=1
SCOUT_MAX_JOB_RUNTIME_SECONDS=1800
SCOUT_MAX_REPO_SIZE_MB=2048

# --- Notifications ---------------------------------------------------------
SCOUT_NOTIFICATIONS_ENABLED=false
SCOUT_GOOGLE_CHAT_WEBHOOK_URL=
SCOUT_SMTP_HOST=
SCOUT_SMTP_PORT=587
SCOUT_SMTP_USERNAME=
SCOUT_SMTP_PASSWORD=
SCOUT_EMAIL_FROM=scout@edrevel.ai
SCOUT_EMAIL_TO=

# --- Observability ---------------------------------------------------------
SCOUT_OTEL_ENABLED=false
SCOUT_OTEL_EXPORTER_ENDPOINT=http://localhost:4318
SCOUT_OTEL_SERVICE_NAME=scout-api
