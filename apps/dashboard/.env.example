# Base URL of the Scout control-plane API.
#
# This is the ONLY place the API host is configured. It is read by
# src/api/client.ts at build time (Vite inlines `import.meta.env.*`), and it is
# also used as the dev-server proxy target in vite.config.ts.
#
# In dev the app calls the API through the Vite proxy, so this can stay on
# localhost with no CORS configuration:
#   GET http://localhost:5173/api/v1/jobs  ->  http://localhost:8000/api/v1/jobs
#
# In a production build, set this to the real API origin (for example
# https://scout-api.internal.example.com) and rebuild. The browser will then
# fetch that origin directly, so that origin must allow the dashboard origin
# via CORS.
VITE_SCOUT_API_URL=http://localhost:8000
